# Flashscore Analytics — lokale Secrets (nicht committen)
# Datei kopieren nach .env und die Keys einfügen:
#   copy .env.example .env

# sstats.net API
SSTATS_API_KEY=
# SSTATS_BASE_URL=https://api.sstats.net
# Nur für eine feste Stunden-Verschiebung; leer = Europe/Zurich inkl. Sommer-/Winterzeit
# TIMEZONE=1
# Nur Oracle-Server: sstats ueber Cloudflare WARP (deploy/ORACLE.md)
# SSTATS_PROXY=socks5h://127.0.0.1:40000

# Key erzeugen: https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
